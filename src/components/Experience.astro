---
import Section from './Section.astro';
import SkillPill from './SkillPill.astro';
import { experience } from '../consts';
---

<Section title="Work Experience" id="experience">
  <ol class="space-y-8">
    {
      experience.map((job) => (
        <li>
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <h3 class="font-medium">{job.title}</h3>
            <p class="shrink-0 text-sm text-zinc-500 tabular-nums dark:text-zinc-400">
              {job.start} – {job.end}
            </p>
          </div>
          <p class="mt-0.5 text-zinc-600 dark:text-zinc-400">{job.organization}</p>

          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-zinc-700 marker:text-zinc-400 dark:text-zinc-300 dark:marker:text-zinc-600">
            {job.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>

          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Skills">
            {job.skills.map((skill) => <SkillPill label={skill} />)}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
