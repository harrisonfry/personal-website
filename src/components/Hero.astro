---
import { Image } from 'astro:assets';
import profilePicture from '../assets/profile-picture.jpg';
import { site } from '../consts';
---

<header class="flex flex-col items-center gap-5 pt-6 pb-10 text-center sm:flex-row sm:gap-7 sm:text-left">
  {/* height + widths makes Astro emit a srcset and use the smallest variant
      as the fallback src, so the full-size original is never downloaded. */}
  <Image
    src={profilePicture}
    alt={`Portrait of ${site.name}`}
    height={128}
    widths={[128, 256]}
    sizes="128px"
    loading="eager"
    format="webp"
    quality={82}
    class="size-28 max-w-none shrink-0 rounded-full object-cover object-[center_22%] ring-4 ring-white outline outline-zinc-200 sm:size-32 dark:ring-zinc-950 dark:outline-zinc-800"
  />

  <div class="min-w-0">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{site.name}</h1>
    <p class="mt-2 text-lg text-zinc-600 dark:text-zinc-400">{site.role}</p>
  </div>
</header>
